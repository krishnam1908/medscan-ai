# MedScan AI — environment config
# Copy this file to `.env` and fill in values.

# Port the API server listens on
PORT=5000

# Optional: add an OpenAI API key with vision access to enable REAL prescription OCR.
# If left blank, the server uses a built-in realistic mock parser (perfect for offline demos).
OPENAI_API_KEY=

# Which OpenAI vision model to use (only used when OPENAI_API_KEY is set)
OPENAI_MODEL=gpt-4o-mini
